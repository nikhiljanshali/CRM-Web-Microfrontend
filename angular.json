{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "CRM.Admin": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/CRM.Admin",
      "sourceRoot": "projects/CRM.Admin/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/CRM.Admin",
            "index": "projects/CRM.Admin/src/index.html",
            "main": "projects/CRM.Admin/src/main.ts",
            "polyfills": "projects/CRM.Admin/src/polyfills.ts",
            "tsConfig": "projects/CRM.Admin/tsconfig.app.json",
            "aot": true,
            "assets": [
              "projects/CRM.Admin/src/favicon.ico",
              "projects/CRM.Admin/src/assets",
              {
                "glob": "**/*",
                "input": "assets",
                "output": "commonAssets"
              }
            ],
            "styles": [
              "./node_modules/bootstrap/dist/css/bootstrap.min.css",
              "./node_modules/ngx-bootstrap/datepicker/bs-datepicker.css",
              "node_modules/bootstrap/dist/css/bootstrap.css",
              "assets/css/all.css",
              "projects/CRM.Admin/src/styles.css",
              "./node_modules/intl-tel-input/build/css/intlTelInput.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "environments/environment.ts",
                  "with": "environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractCss": true,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "20kb"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "CRM.Admin:build",
            "port": 4200
          },
          "configurations": {
            "production": {
              "browserTarget": "CRM.Admin:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "CRM.Admin:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/CRM.Admin/src/test.ts",
            "polyfills": "projects/CRM.Admin/src/polyfills.ts",
            "tsConfig": "projects/CRM.Admin/tsconfig.spec.json",
            "karmaConfig": "projects/CRM.Admin/karma.conf.js",
            "assets": [
              "projects/CRM.Admin/src/favicon.ico",
              "projects/CRM.Admin/src/assets",
              {
                "glob": "**/*",
                "input": "assets",
                "output": "commonAssets"
              }
            ],
            "styles": [
              "./node_modules/bootstrap/dist/css/bootstrap.min.css",
              "./node_modules/ngx-bootstrap/datepicker/bs-datepicker.css",
              "projects/CRM.Admin/src/styles.css",
              "./node_modules/intl-tel-input/build/css/intlTelInput.css"
            ],
            "scripts": []
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "projects/CRM.Admin/tsconfig.app.json",
              "projects/CRM.Admin/tsconfig.spec.json",
              "projects/CRM.Admin/e2e/tsconfig.json"
            ],
            "exclude": [
              "**/node_modules/**"
            ]
          }
        },
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "projects/CRM.Admin/e2e/protractor.conf.js",
            "devServerTarget": "CRM.Admin:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "CRM.Admin:serve:production"
            }
          }
        }
      }
    },
